# 复制为 .env 后按需填写；全部留空也能启动。
# 任何真实密钥都不得提交到 Git、写入日志或文档。

# 主数据库（留空 → data/p1.db；切换 PostgreSQL 时填写完整连接串）
# 示例：postgresql://USER:PASSWORD@HOST:5432/DBNAME
P1_DATABASE_URL=

# LLM（OpenAI 兼容；留空时 LLM_MODE=auto 自动 mock）
API_KEY=
MODEL_NAME=deepseek-chat
BASE_URL=https://api.deepseek.com
LLM_MODE=auto

# 语音识别（DashScope Qwen-ASR-Realtime；Key 留空时 ASR_MODE=auto 自动 mock）
ASR_MODE=auto
ASR_PROVIDER=qwen3-asr-flash-realtime
ASR_API_KEY=
ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
ASR_MODEL_NAME=qwen3-asr-flash-realtime
ASR_LANGUAGE=zh
ASR_SAMPLE_RATE=16000
ASR_AUDIO_FORMAT=pcm
ASR_TIMEOUT_SECONDS=30
ASR_MOCK_TEXT=上周八年级各班出勤率

# 飞书群机器人（应用凭据留空时 FEISHU_MODE=auto 自动 mock）
FEISHU_MODE=auto
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_DEFAULT_CHAT_ID=
FEISHU_MOCK_CHAT_ID=oc_mock_campus
FEISHU_ALLOW_WRITES=false
# 长连接接收群消息，无需公网回调地址
FEISHU_LONG_CONNECTION=true
FEISHU_TIMEOUT_SECONDS=15

# Langfuse LLM 观测（默认关闭；关闭或缺少凭据时不发起任何网络请求）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=production
LANGFUSE_RELEASE=smartdeck-0.2.0
LANGFUSE_TIMEOUT_SECONDS=5
LANGFUSE_FLUSH_INTERVAL_SECONDS=1
LANGFUSE_CAPTURE_CONTENT=true

# 效果评测（只写内存与本地 JSONL/JSON，不新增数据库表）
EVAL_FAILURE_LOG=false
EVAL_FAILURE_LOG_PATH=data/evals/failure_cases.jsonl
EVAL_GOLDEN_OUTPUT=data/evals/latest.json
TEXT2SQL_SCHEMA_RETRIEVAL=true
